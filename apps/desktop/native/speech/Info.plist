<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Linked into the helper binary: macOS refuses speech recognition to a process without these. -->
<plist version="1.0">
  <dict>
    <key>CFBundleIdentifier</key>
    <string>com.whateverfi.desktop.speech</string>
    <key>CFBundleName</key>
    <string>WhatEverFi</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>WhatEverFi turns what you say into text for dictation and voice calls with your bots.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>WhatEverFi uses the microphone for dictation and voice calls with your bots.</string>
  </dict>
</plist>
