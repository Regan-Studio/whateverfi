{
  "$comment": "WhatEverFi / Regan.Studio overlay. Required rules must match at least once. LICENSE and 'Copyright 2026 Rakazo contributors' are never rewritten (enforced in apply-overlay.mjs).",
  "brand": "WhatEverFi",
  "company": "Regan.Studio",
  "companyUrl": "https://regan.studio",
  "siteUrl": "https://whateverfi.com",
  "appUrl": "https://app.whateverfi.com",
  "githubUrl": "https://github.com/Regan-Studio/whateverfi",
  "scope": {
    "include": [
      "apps/www",
      "docs",
      "infra/compose",
      "packages/core/src",
      "packages/i18n/src",
      "packages/ui-web/src",
      "packages/contracts/src",
      ".github/ISSUE_TEMPLATE"
    ],
    "exclude": [
      "node_modules",
      "dist",
      ".astro",
      ".vercel",
      "overlays",
      ".git",
      "generated",
      ".cache",
      ".turbo"
    ],
    "textExtensions": [
      ".ts",
      ".tsx",
      ".mjs",
      ".js",
      ".astro",
      ".md",
      ".mdx",
      ".json",
      ".txt",
      ".svg",
      ".webmanifest",
      ".css",
      ".html",
      ".xml",
      ".yml",
      ".yaml",
      ".sh",
      ".example",
      ".po",
      ".swift",
      ".strings"
    ],
    "rootFiles": [
      "README.md",
      "README.ja.md",
      "README.th-TH.md",
      "README.zh-CN.md",
      "SETUP_PROMPT.md",
      "SECURITY.md",
      "CONTRIBUTING.md",
      "PRODUCT.md"
    ],
    "linkInclude": ["."]
  },
  "renameFiles": {
    "roots": ["apps/www/public", "apps/www/src/content"],
    "from": "rakazo",
    "to": "whateverfi"
  },
  "rules": [
    {
      "id": "www-url",
      "find": "https://www\\.rakazo\\.com",
      "replace": "https://www.whateverfi.com",
      "group": "links"
    },
    {
      "id": "www-host",
      "find": "(?<![\\w.-])www\\.rakazo\\.com",
      "replace": "www.whateverfi.com",
      "required": true,
      "group": "links"
    },
    {
      "id": "site-url",
      "find": "https://rakazo\\.com",
      "replace": "https://whateverfi.com",
      "required": true,
      "group": "links"
    },
    {
      "id": "app-url",
      "find": "https://app\\.rakazo\\.com(?!/api/v1/integration-claims)",
      "replace": "https://app.whateverfi.com",
      "required": true,
      "$comment": "Do not retarget the build-time integration-claims feed (app.whateverfi.com has no API yet)."
    },
    {
      "id": "restore-claims-url",
      "file": "apps/www/src/site.ts",
      "find": "export const INTEGRATION_CLAIMS_URL = \"https://app\\.whateverfi\\.com/api/v1/integration-claims\";",
      "replace": "export const INTEGRATION_CLAIMS_URL = \"https://app.rakazo.com/api/v1/integration-claims\";",
      "required": true,
      "$comment": "Re-assert the intentional claims-feed leftover after app-url / site-url rewrites."
    },
    {
      "id": "app-host",
      "find": "(?<![\\w./-])app\\.rakazo\\.com",
      "replace": "app.whateverfi.com"
    },
    {
      "id": "emails",
      "find": "([A-Za-z0-9._%+-]+)@rakazo\\.com",
      "replace": "$1@whateverfi.com",
      "required": true,
      "group": "links"
    },
    {
      "id": "bare-domain",
      "find": "(?<![\\w.@/-])rakazo\\.com\\b",
      "replace": "whateverfi.com",
      "group": "links"
    },
    {
      "id": "utm-source",
      "find": "utm_source=rakazo",
      "replace": "utm_source=whateverfi"
    },
    {
      "id": "github-repo",
      "find": "https://github\\.com/elie222/rakazo",
      "replace": "https://github.com/Regan-Studio/whateverfi",
      "required": true,
      "group": "links"
    },
    {
      "id": "raw-github",
      "find": "https://raw\\.githubusercontent\\.com/elie222/rakazo",
      "replace": "https://raw.githubusercontent.com/Regan-Studio/whateverfi",
      "required": true,
      "group": "links"
    },
    {
      "id": "ghcr-image",
      "find": "ghcr\\.io/elie222/rakazo",
      "replace": "ghcr.io/regan-studio/whateverfi",
      "required": true,
      "$comment": "Images are published to ghcr.io/regan-studio/whateverfi from main (edge + sha tags). Packages may still be private. See overlays/whateverfi/GHCR-UNPUBLISHED.md.",
      "group": "links"
    },
    {
      "id": "github-api",
      "find": "https://api\\.github\\.com/repos/elie222/rakazo",
      "replace": "https://api.github.com/repos/Regan-Studio/whateverfi",
      "required": true,
      "group": "links"
    },
    {
      "id": "github-short",
      "find": "elie222/rakazo",
      "replace": "Regan-Studio/whateverfi",
      "required": true,
      "$comment": "Badge slugs and owner/repo short names. Must run after the full URL rules.",
      "group": "links"
    },
    {
      "id": "ghcr-case",
      "group": "links",
      "find": "ghcr\\.io/Regan-Studio/whateverfi",
      "replace": "ghcr.io/regan-studio/whateverfi",
      "required": false,
      "$comment": "github-short uses the GitHub owner spelling (Regan-Studio). GHCR image names must be lowercase. Also pin PUBLISHED_IMAGE_REPO to lowercase."
    },
    {
      "id": "ghcr-github-repository-expr",
      "group": "links",
      "find": "ghcr\\.io/\\$\\{\\{\\s*github\\.repository\\s*\\}\\}",
      "replace": "ghcr.io/regan-studio/whateverfi",
      "required": true,
      "$comment": "github.repository expands to Regan-Studio/whateverfi (mixed case). GHCR and docker buildx require lowercase; docker/build-push-action passes the un-lowercased name= and fails. Weekly sync will keep rewriting the upstream expression."
    },
    {
      "id": "desktop-app-id",
      "group": "links",
      "find": "dev\\.rakazo\\.desktop",
      "replace": "com.whateverfi.desktop",
      "required": true,
      "$comment": "Electron appId and related desktop bundle ids (speech helper CFBundleIdentifier, passkey docs and tests). Does not match mobile com.rakazo.app."
    },
    {
      "id": "install-images-ghcr-status",
      "file": "infra/compose/install-images.sh",
      "find": "# WARNING: ghcr\\.io/regan-studio/whateverfi images are not published yet\\.\\n# This script's default image names will 404 until they are\\. Build from this\\n# repo, or see overlays/whateverfi/GHCR-UNPUBLISHED\\.md\\.",
      "replace": "# Images ghcr.io/regan-studio/whateverfi/{app,updater,computer}:edge are published from main.\n# Packages may still be private on GHCR (a pull without a login returns 401) until\n# visibility is Public. See overlays/whateverfi/GHCR-UNPUBLISHED.md.",
      "required": true,
      "$comment": "Keeps the installer warning in sync with published-but-private GHCR status."
    },
    {
      "id": "published-image-repo",
      "file": "packages/core/src/compose-update.ts",
      "group": "links",
      "find": "export const PUBLISHED_IMAGE_REPO = \"Regan-Studio/whateverfi\";",
      "replace": "export const PUBLISHED_IMAGE_REPO = \"regan-studio/whateverfi\";",
      "required": true,
      "$comment": "Must run after github-short, which would otherwise leave a mixed-case GHCR namespace."
    },
    {
      "id": "restore-sync-upstream-url",
      "file": ".github/workflows/whateverfi-product-sync-upstream.yml",
      "group": "links",
      "find": "UPSTREAM_URL: https://github\\.com/Regan-Studio/whateverfi\\.git",
      "replace": "UPSTREAM_URL: https://github.com/elie222/rakazo.git",
      "required": true,
      "$comment": "github-short would retarget the weekly job's fetch URL at this repo. It must keep fetching elie222/rakazo. branding-guard already excludes this workflow file."
    },
    {
      "id": "split-owner-repo-json",
      "group": "links",
      "find": "\"owner\": \"elie222\",(\\s*)\"repo\": \"rakazo\"",
      "replace": "\"owner\": \"Regan-Studio\",$1\"repo\": \"whateverfi\"",
      "$comment": "electron-builder publish and other split JSON owner/repo fields. github-short only matches the joined slug elie222/rakazo."
    },
    {
      "id": "split-owner-yaml",
      "group": "links",
      "find": "owner: elie222",
      "replace": "owner: Regan-Studio",
      "$comment": "app-update.yml checks and PowerShell expected-owner lists in release-desktop.yml."
    },
    {
      "id": "split-repo-yaml",
      "group": "links",
      "find": "repo: rakazo(?![-_])",
      "replace": "repo: whateverfi",
      "$comment": "Paired with split-owner-yaml. Negative lookahead keeps rakazo-prod / rakazo-computer-egress names."
    },
    {
      "id": "desktop-executable-name",
      "file": "apps/desktop/package.json",
      "group": "links",
      "find": "\"executableName\": \"rakazo\"",
      "replace": "\"executableName\": \"whateverfi\"",
      "required": true
    },
    {
      "id": "first-party-image-regex",
      "group": "links",
      "find": "ghcr\\\\\\.io\\\\/elie222\\\\/rakazo",
      "replace": "ghcr\\.io\\/regan-studio\\/whateverfi",
      "$comment": "Test regexes that escaped the ghcr.io/elie222/rakazo path, which github-short does not match."
    },
    {
      "id": "reserved-header-prefix",
      "group": "links",
      "find": "startsWith\\(\"x-rakazo-\"\\)",
      "replace": "startsWith(\"x-whateverfi-\")",
      "required": true,
      "$comment": "brand-word rewrote test header names to X-WhatEverFi-*; the reserved-prefix check must match."
    },
    {
      "id": "release-watch-mentions-repo",
      "file": "packages/adapters/src/release-watch.ts",
      "group": "links",
      "find": "/rakazo\\|elie222/i",
      "replace": "/rakazo|elie222|whateverfi|regan-studio/i",
      "required": true
    },
    {
      "id": "release-watch-default-owner",
      "file": "packages/adapters/src/release-watch.ts",
      "group": "links",
      "find": "owner: \"elie222\",(\\s*)repo: \"rakazo\",",
      "replace": "owner: \"Regan-Studio\",$1repo: \"whateverfi\","
    },
    {
      "id": "composio-default-owner",
      "file": "packages/adapters/src/composio-fake.ts",
      "group": "links",
      "find": "args\\.owner \\?\\? args\\.owner_name \\?\\? \"elie222\"",
      "replace": "args.owner ?? args.owner_name ?? \"Regan-Studio\""
    },
    {
      "id": "composio-owner-example",
      "file": "packages/adapters/src/composio-fake.ts",
      "group": "links",
      "find": "Repository owner, e\\.g\\. elie222",
      "replace": "Repository owner, e.g. Regan-Studio"
    },
    {
      "id": "composio-test-owner-repo",
      "group": "links",
      "find": "owner: \"elie222\", repo: \"rakazo\"",
      "replace": "owner: \"Regan-Studio\", repo: \"whateverfi\""
    },
    {
      "id": "release-watch-prompt-owner",
      "group": "links",
      "find": "owner elie222 repo rakazo",
      "replace": "owner Regan-Studio repo whateverfi"
    },
    {
      "id": "logo-avatar-class",
      "group": "links",
      "find": "rakazo-logo-avatar",
      "replace": "whateverfi-logo-avatar",
      "required": true,
      "$comment": "ui-web class was retargeted; tests outside the original include scope still queried .rakazo-logo-avatar."
    },
    {
      "id": "play-store-url",
      "group": "links",
      "find": "https://play\\.google\\.com/store/apps/details\\?id=com\\.rakazo\\.app",
      "replace": "https://app.whateverfi.com/",
      "$comment": "WhatEverFi has no Play listing yet; android-app-url already retargeted the product constant. Tests use HTMLHyperlinkElementUtils.href, which adds a trailing slash."
    },
    {
      "id": "image-alias-case",
      "group": "links",
      "find": "(?<!github\\.com/)(?<!repos/)Regan-Studio/whateverfi/",
      "replace": "regan-studio/whateverfi/",
      "$comment": "github-short leaves mixed-case GitHub owner spelling in image aliases; GHCR/OCI aliases are lowercase. Does not rewrite github.com/Regan-Studio/whateverfi URLs."
    },
    {
      "id": "self-update-identity-case",
      "file": "packages/core/src/self-update.test.ts",
      "group": "links",
      "find": "github\\.com/Regan-Studio/whateverfi",
      "replace": "github.com/regan-studio/whateverfi",
      "required": true,
      "$comment": "repoIdentity() lowercases the host/path. elie222 was already lowercase; Regan-Studio is not."
    },
    {
      "id": "smoke-download-ref-path",
      "file": "infra/compose/install-images-pull-never.smoke.sh",
      "group": "links",
      "find": "rakazo/\\[\\^/\\]\\+/infra/compose",
      "replace": "whateverfi/[^/]+/infra/compose",
      "required": true,
      "$comment": "Smoke extracted raw.githubusercontent.com/.../rakazo/<ref>/infra/compose; the path segment is now whateverfi."
    },
    {
      "id": "linux-update-signature-filename",
      "file": "apps/desktop/src/linux-update-signature.test.ts",
      "group": "links",
      "find": "\\\\nRakazo-1\\\\.2\\\\.3\\\\.AppImage",
      "replace": "\\\\nWhatEverFi-1.2.3.AppImage",
      "$comment": "The signed payload's third line is the product filename; brand-word rewrote the input but not this expected string in the same literal."
    },
    {
      "id": "passkey-example-host",
      "file": "apps/desktop/src/passkeys.test.ts",
      "group": "links",
      "find": "toBe\\(\"rakazo\\.example\\.org\"\\)",
      "replace": "toBe(\"whateverfi.example.org\")"
    },
    {
      "id": "passkey-example-entitlement",
      "file": "apps/desktop/src/passkeys.test.ts",
      "group": "links",
      "find": "webcredentials:rakazo\\.example\\.org",
      "replace": "webcredentials:whateverfi.example.org"
    },
    {
      "id": "sandbox-windows-product-dir",
      "file": "packages/adapters/src/desktop-sandbox-paths.test.ts",
      "group": "links",
      "find": "users\\\\\\\\owner\\\\\\\\rakazo\\\\\\\\",
      "replace": "users\\\\\\\\owner\\\\\\\\whateverfi\\\\\\\\",
      "$comment": "Keep the requested path's product-dir casing in sync with the WhatEverFi root."
    },
    {
      "id": "builtin-skills-docs-regex",
      "file": "packages/adapters/src/builtin-skills.test.ts",
      "group": "links",
      "find": "https:\\\\/\\\\/rakazo\\\\.com\\\\/docs\\\\/",
      "replace": "https:\\\\/\\\\/whateverfi\\\\.com\\\\/docs\\\\/"
    },
    {
      "id": "builtin-skill-description-length",
      "file": "packages/adapters/src/builtin-skills.ts",
      "find": "How to use or set up WhatEverFi: chat apps, your computer, billing, hosting",
      "replace": "How to use or set up WhatEverFi: apps, your computer, billing, hosting",
      "required": true,
      "$comment": "WhatEverFi is longer than Rakazo; the skill picker truncates at 72 characters.",
      "group": "links"
    },
    {
      "id": "normalize-official-repo-case",
      "file": "packages/core/src/self-update.test.ts",
      "group": "links",
      "find": "url: \"https://github.com/regan-studio/whateverfi\"",
      "replace": "url: \"https://github.com/Regan-Studio/whateverfi\"",
      "required": true,
      "$comment": "normalizeRepoUrl does not lowercase; repoIdentity does. self-update-identity-case must not rewrite this expectation."
    },
    {
      "id": "repo-identity-case-variant",
      "file": "packages/core/src/self-update.test.ts",
      "group": "links",
      "find": "ssh://git@github.com/Elie222/WhatEverFi",
      "replace": "ssh://git@github.com/Regan-Studio/WhatEverFi",
      "required": true,
      "$comment": "The upstream case-fold fixture was Elie222/Rakazo. brand-word left the old owner and produced the corrupted slug elie222/whateverfi."
    },
    {
      "id": "smoke-unpinned-download-ref",
      "file": "infra/compose/install-images-pull-never.smoke.sh",
      "group": "links",
      "find": "rakazo/(?=v[0-9]|main/infra/compose)",
      "replace": "whateverfi/",
      "required": true
    },
    {
      "id": "deploy-example-ghcr-repo",
      "file": "packages/testkit/src/deploy-script.test.ts",
      "group": "links",
      "find": "ghcr\\.io/example/rakazo/",
      "replace": "ghcr.io/example/whateverfi/"
    },
    {
      "id": "desktop-host-own-window-name",
      "file": "packages/adapters/src/agent-desktop-host-screen.test.ts",
      "group": "links",
      "find": "observe\\(scope, \"rakazo\"\\)",
      "replace": "observe(scope, \"whateverfi\")",
      "required": true,
      "$comment": "The product refuses to drive its own window; the program name is the Linux executableName."
    },
    {
      "id": "company-url",
      "find": "https://www\\.getinboxzero\\.com/[^\"'`\\s)]*",
      "replace": "https://regan.studio",
      "required": true
    },
    {
      "id": "company-name-inc",
      "find": "Inbox Zero Inc\\.",
      "replace": "Regan.Studio",
      "required": true
    },
    {
      "id": "company-short-quoted",
      "find": "\\(\"Inbox Zero,\"",
      "replace": "(\"Regan.Studio,\""
    },
    {
      "id": "company-short",
      "find": "\\bInbox Zero\\b",
      "replace": "Regan.Studio"
    },
    {
      "id": "company-address",
      "find": "\\s*131 Continental Dr, Suite 305(<br\\s*/>)?\\s*\\n?\\s*Newark, Delaware 19713, United States(<br\\s*/>)?",
      "replace": "",
      "$comment": "Upstream postal address removed; Regan.Studio address unknown."
    },
    {
      "id": "footer-legal",
      "file": "apps/www/src/components/Footer.astro",
      "find": "<span>\u00a9 2026 <a href=\\{INBOX_ZERO_URL\\} target=\"_blank\" rel=\"noopener\">Regan.Studio</a></span>\\s*<span>Apache-2\\.0</span>",
      "replace": "<span>\u00a9 2026 <a href=\"https://regan.studio\" rel=\"noopener\">Regan.Studio</a></span>\n      <span>Based on Rakazo (<a href=\"/about/#license\">Apache-2.0</a>)</span>",
      "required": true,
      "$comment": "Matches after company-name-inc has rewritten Inbox Zero Inc. to Regan.Studio."
    },
    {
      "id": "about-license",
      "file": "apps/www/src/pages/about.astro",
      "find": "<h2>Open by default</h2>\\s*<p>\\s*Rakazo is maintained by Regan.Studio and released under the Apache-2\\.0 license\\.",
      "replace": "<h2 id=\"license\">Open by default</h2>\n      <p>\n        WhatEverFi is operated by Regan.Studio and released under the Apache-2.0 license. Based on Rakazo (Apache-2.0).",
      "required": true,
      "$comment": "Matches after company-name-inc, before/independent of brand-word (this rule itself writes WhatEverFi)."
    },
    {
      "id": "brand-word",
      "find": "(?<!Based on )(?<!based on )(?<![\\w.])Rakazo(?![\\w.])",
      "replace": "WhatEverFi",
      "required": true,
      "group": "links",
      "$comment": "Repo-wide product name, including tests. Leaves 'Based on Rakazo' attribution, the Rakazo.icon asset filename, and hostnames like App.Rakazo.com unchanged."
    },
    {
      "id": "brand-word-before-period",
      "find": "(?<!Based on )(?<!based on )(?<![\\w.])Rakazo(?=\\.(?![iI]con))",
      "replace": "WhatEverFi",
      "required": false,
      "group": "links",
      "$comment": "brand-word's lookahead treats '.' as a stopper so it can keep Rakazo.icon. This rule still rewrites sentence-final 'Rakazo.' (and 'in Rakazo.') while leaving Rakazo.icon and App.Rakazo.com alone."
    },
    {
      "id": "maestro-name-rakazo",
      "find": "name: Rakazo(?=\\.)",
      "replace": "name: WhatEverFi",
      "required": false,
      "group": "links",
      "$comment": "Maestro flow used a regex '.*name: Rakazo.*' which brand-word also skips because of the trailing dot."
    },
    {
      "id": "brand-upper",
      "find": "\\bRAKAZO\\b",
      "replace": "WHATEVERFI"
    },
    {
      "id": "logo-word",
      "find": "(<span class=\"brand-lockup__word\">)rakazo(</span>)",
      "replace": "$1WhatEverFi$2",
      "required": true
    },
    {
      "id": "claims-data-source",
      "file": "apps/www/src/site.ts",
      "find": "`\\$\\{APP_URL\\}/api/v1/integration-claims`",
      "replace": "\"https://app.rakazo.com/api/v1/integration-claims\"",
      "required": true,
      "$comment": "Build-time data feed only; app.whateverfi.com has no API. This is an intentional leftover app.rakazo.com URL, not a user-facing install link."
    },
    {
      "id": "testimonials",
      "file": "apps/www/src/i18n/home.ts",
      "find": "(const TESTIMONIALS: HomeCopy\\[\"testimonials\"\\]\\[\"items\"\\] = )\\[[\\s\\S]*?\\n\\];",
      "replace": "$1[];",
      "required": true
    },
    {
      "id": "testimonials-remove",
      "file": "apps/www/src/components/HomePage.astro",
      "find": "\\n\\s*<section id=\"testimonials\" class=\"section testimonials\"[\\s\\S]*?\\n      </section>",
      "replace": "",
      "required": true
    },
    {
      "id": "testimonials-markdown",
      "file": "apps/www/src/agent-content.ts",
      "find": "## \\$\\{home\\.testimonials\\.heading\\}\\n\\n\\$\\{home\\.testimonials\\.items[^\\n]*\\n\\n",
      "replace": "",
      "required": true
    },
    {
      "id": "star-pill",
      "file": "apps/www/src/components/Header.astro",
      "find": "<span aria-hidden=\"true\">\u2605</span>\\s*<span>\\{starsLabel\\}</span>",
      "replace": "<span>GitHub</span>",
      "required": true,
      "$comment": "Do not present upstream star counts as WhatEverFi's."
    },
    {
      "id": "stats-no-stars",
      "file": "apps/www/src/components/HomePage.astro",
      "find": "copy\\.cta\\.stats\\.map\\(",
      "replace": "copy.cta.stats.filter((stat) => stat.value !== \"stars\").map(",
      "required": true
    },
    {
      "id": "ios-app-url",
      "file": "apps/www/src/site.ts",
      "find": "export const IOS_APP_URL = \"https://apps\\.apple\\.com/app/rakazo/id\\d+\";",
      "replace": "export const IOS_APP_URL = APP_URL;",
      "required": true
    },
    {
      "id": "android-app-url",
      "file": "packages/contracts/src/client-build.ts",
      "find": "\"https://play\\.google\\.com/store/apps/details\\?id=com\\.rakazo\\.app\"",
      "replace": "\"https://app.whateverfi.com\"",
      "required": true
    },
    {
      "id": "desktop-download-import",
      "file": "apps/www/src/github.ts",
      "find": "import \\{ GITHUB_API_REPO \\} from \"\\./site\";",
      "replace": "import { APP_URL, GITHUB_API_REPO } from \"./site\";",
      "required": true
    },
    {
      "id": "desktop-download-href",
      "file": "apps/www/src/github.ts",
      "find": "return `/api/download\\?platform=\\$\\{platform\\}`;",
      "replace": "void platform;\n  return APP_URL;",
      "required": true
    },
    {
      "id": "home-desktop-links",
