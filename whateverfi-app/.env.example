# WhatEverFi app — values layered on top of upstream .env.images.example by scripts/install.sh.
# PLACEHOLDERS ONLY. The real .env lives in the runtime folder on the server (never in git).
# install.sh / upstream install-images.sh generate POSTGRES_PASSWORD, POSTGRES_APP_PASSWORD,
# BETTER_AUTH_SECRET, ENCRYPTION_KEY, SCREEN_PROXY_SECRET and SANDBOX_SUPERVISOR_TOKEN automatically.

# --- Public origin (served through the Cloudflare Tunnel) ---
BETTER_AUTH_URL=https://app.whateverfi.com
WEB_ORIGIN=https://app.whateverfi.com
API_URL=https://app.whateverfi.com
RAKAZO_HOST=app.whateverfi.com
# Keep the web port on loopback; the tunnel reaches it over the Compose network.
RAKAZO_WEB_BIND=127.0.0.1
RAKAZO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Pinned images (see upstream.env) ---
RAKAZO_IMAGE_TAG=sha-1115613b8d007328c5a625a1cc2b096161a5788c
RAKAZO_COMPUTER_IMAGE_TAG=sha-1115613b8d007328c5a625a1cc2b096161a5788c

# --- WhatEverFi look (theme/theme.json mounted by docker-compose.override.yml) ---
RAKAZO_THEME=/theme/theme.json

# --- Bot computers: local Docker via the in-stack supervisor ---
SANDBOX_PROVIDER=docker

# --- Sign-up policy (decide before launch) ---
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=

# --- Cloudflare Tunnel connector token (written by scripts/cloudflare-tunnel.sh) ---
TUNNEL_TOKEN=

# --- NEEDS FROM USER (optional but needed for a useful app) ---
# Model access: an OpenRouter key here, or connect a model in the UI after sign-up.
OPENROUTER_API_KEY=
# Plugins (Composio) — optional.
COMPOSIO_API_KEY=
# Password-recovery / welcome email (e.g. Resend SMTP) — optional.
SMTP_URL=
EMAIL_FROM=
